# Copy this file to backend/.env for local API configuration.
# This relative SQLite path resolves from the backend working directory.
DATABASE_URL=sqlite:///./nexus.db

# Pydantic Settings expects a JSON list for this field.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local Ollama endpoints and models. No API key is required for local Ollama.
NEXUS_OLLAMA_URL=http://localhost:11434/api/chat
NEXUS_OLLAMA_MODEL=qwen3:8b

# Internal document routes are disabled by default and loopback-only when enabled.
NEXUS_ENABLE_LOCAL_INTERNAL_SOURCES=0

# Optional PostgreSQL example (replace the placeholder; never commit credentials):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/nexus
